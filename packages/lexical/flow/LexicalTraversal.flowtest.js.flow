// Type-only coverage for the public traversal declarations; never run.
import type {ElementNode, LexicalNode, ParagraphNode, TextNode} from 'lexical';

import {$filter} from '@lexical/utils';
import {
  $cloneWithProperties,
  $getNodeByKey,
  $getNodeByKeyOrThrow,
  $isParagraphNode,
  $isTextNode,
} from 'lexical';

export function flowTraversalTypes(
  node: LexicalNode,
  element: ElementNode,
): void {
  // Every previously deprecated unchecked overload refuses type arguments.
  // $FlowExpectedError[nonpolymorphic-type-arg]
  node.getParent<ParagraphNode>();
  // $FlowExpectedError[nonpolymorphic-type-arg]
  node.getParentOrThrow<ParagraphNode>();
  // $FlowExpectedError[nonpolymorphic-type-arg]
  node.getParents<ParagraphNode>();
  // $FlowExpectedError[nonpolymorphic-type-arg]
  node.getPreviousSibling<TextNode>();
  // $FlowExpectedError[nonpolymorphic-type-arg]
  node.getPreviousSiblings<TextNode>();
  // $FlowExpectedError[nonpolymorphic-type-arg]
  node.getNextSibling<TextNode>();
  // $FlowExpectedError[nonpolymorphic-type-arg]
  node.getNextSiblings<TextNode>();
  // $FlowExpectedError[nonpolymorphic-type-arg]
  element.getChildren<TextNode>();
  // $FlowExpectedError[nonpolymorphic-type-arg]
  element.getChildren<LexicalNode[]>();
  // $FlowExpectedError[nonpolymorphic-type-arg]
  element.getChildAtIndex<TextNode>(0);
  // $FlowExpectedError[nonpolymorphic-type-arg]
  element.getFirstChild<TextNode>();
  // $FlowExpectedError[nonpolymorphic-type-arg]
  element.getFirstChildOrThrow<TextNode>();
  // $FlowExpectedError[nonpolymorphic-type-arg]
  element.getLastChild<TextNode>();
  // $FlowExpectedError[nonpolymorphic-type-arg]
  element.getLastChildOrThrow<TextNode>();
  // $FlowExpectedError[nonpolymorphic-type-arg]
  element.getFirstDescendant<TextNode>();
  // $FlowExpectedError[nonpolymorphic-type-arg]
  element.getLastDescendant<TextNode>();
  // $FlowExpectedError[nonpolymorphic-type-arg]
  element.getDescendantByIndex<TextNode>(0);
  // $FlowExpectedError[nonpolymorphic-type-arg]
  $getNodeByKey<TextNode>(node.getKey());
  // $FlowExpectedError[nonpolymorphic-type-arg]
  $getNodeByKeyOrThrow<TextNode>(node.getKey());

  // No contextual type can turn an unverified related node into a TextNode.
  // $FlowExpectedError[incompatible-type]
  const unchecked: TextNode | null = element.getFirstChild();
  void unchecked;
  const parent: ElementNode | null = node.getParent();
  const parents: ElementNode[] = node.getParents();
  const children: LexicalNode[] = element.getChildren();
  const firstChild: LexicalNode | null = element.getFirstChild();
  if ($isParagraphNode(parent)) {
    const paragraph: ParagraphNode = parent;
    void paragraph;
  }
  if ($isTextNode(firstChild)) {
    const text: TextNode = firstChild;
    const latest: TextNode = text.getLatest();
    const writable: TextNode = text.getWritable();
    const cloned: TextNode = $cloneWithProperties(text);
    void latest;
    void writable;
    void cloned;
  }
  const found = $getNodeByKeyOrThrow(node.getKey());
  if ($isTextNode(found)) {
    const text: TextNode = found;
    void text;
  }
  // These deprecated generics are safe: the callback/input establishes T.
  const filtered: TextNode[] = $filter(children, n =>
    $isTextNode(n) ? n : null,
  );
  void filtered;
  void parents;
}
