// Checked by `pnpm run flow` (not shipped): typed warnings narrow by code.

import {
  type YWarning,
  DEFAULT_ROOT_NAME,
  isYWarning,
  LAYOUT_VERSION,
  UNSUPPORTED_LAYOUT_WARNING,
} from '@lexical/y';

const root: 'lexical-y' = DEFAULT_ROOT_NAME;
const layout: 1 = LAYOUT_VERSION;

function reasonOf(error: unknown): string {
  if (isYWarning(error)) {
    const warning: YWarning = error;
    if (warning.code === UNSUPPORTED_LAYOUT_WARNING) {
      return warning.data.reason;
    }
    return warning.code;
  }
  return '';
}
