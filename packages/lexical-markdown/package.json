{
  "name": "@lexical/markdown",
  "description": "This package contains Markdown helpers and functionality for Lexical.",
  "keywords": [
    "lexical",
    "editor",
    "rich-text",
    "markdown"
  ],
  "license": "MIT",
  "version": "0.52.0",
  "main": "./dist/LexicalMarkdown.js",
  "types": "./dist/typescript-too-old.d.ts",
  "dependencies": {
    "@lexical/code-core": "workspace:*",
    "@lexical/extension": "workspace:*",
    "@lexical/internal": "workspace:*",
    "@lexical/link": "workspace:*",
    "@lexical/list": "workspace:*",
    "@lexical/rich-text": "workspace:*",
    "@lexical/selection": "workspace:*",
    "@lexical/text": "workspace:*",
    "@lexical/utils": "workspace:*",
    "character-entities": "^2.0.2",
    "lexical": "workspace:*"
  },
  "devDependencies": {
    "@lexical/history": "workspace:*",
    "mdast-util-from-markdown": "^2.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facebook/lexical.git",
    "directory": "packages/lexical-markdown"
  },
  "module": "./dist/LexicalMarkdown.js",
  "sideEffects": false,
  "exports": {
    "./SSRMarkdownExtension": {
      "source": "./src/SSRMarkdownExtension.ts",
      "types@<5.2": "./dist/typescript-too-old.d.ts",
      "types": "./dist/SSRMarkdownExtension.d.ts",
      "development": "./dist/LexicalMarkdownSSRMarkdownExtension.dev.js",
      "production": "./dist/LexicalMarkdownSSRMarkdownExtension.prod.js",
      "default": "./dist/LexicalMarkdownSSRMarkdownExtension.js"
    },
    "./SSRMarkdownExtension.js": {
      "source": "./src/SSRMarkdownExtension.ts",
      "types@<5.2": "./dist/typescript-too-old.d.ts",
      "types": "./dist/SSRMarkdownExtension.d.ts",
      "development": "./dist/LexicalMarkdownSSRMarkdownExtension.dev.js",
      "production": "./dist/LexicalMarkdownSSRMarkdownExtension.prod.js",
      "default": "./dist/LexicalMarkdownSSRMarkdownExtension.js"
    },
    ".": {
      "source": "./src/index.ts",
      "types@<5.2": "./dist/typescript-too-old.d.ts",
      "types": "./dist/index.d.ts",
      "development": "./dist/LexicalMarkdown.dev.js",
      "production": "./dist/LexicalMarkdown.prod.js",
      "default": "./dist/LexicalMarkdown.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "!src/__bench__",
    "!src/__mocks__",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.bench.ts",
    "!src/**/*.bench.tsx",
    "README.md",
    "LICENSE"
  ],
  "typesVersions": {
    "*": {
      "*": [
        "./dist/typescript-too-old.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "typescript": ">=5.2"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "type": "module"
}
