import type {LexicalDropTargetResolver} from '@lexical/clipboard';
import type {LexicalEditor} from 'lexical';

import {$handlePlainTextDrop} from '@lexical/clipboard';

const synchronous: LexicalDropTargetResolver = caret => ({
  caret,
  $beforeInsert: selection => { selection.insertRawText('\n'); },
});

// $FlowExpectedError[incompatible-type] Promise<void> is not Flow void.
const asynchronous: LexicalDropTargetResolver = caret => ({
  caret,
  $beforeInsert: async selection => { selection.insertRawText('\n'); },
});

// $FlowExpectedError[incompatible-type] Flow void accepts only undefined.
const returnsValue: LexicalDropTargetResolver = caret => ({
  caret,
  $beforeInsert: () => 1,
});

export function checkDropTypes(event: DragEvent, editor: LexicalEditor): boolean {
  return $handlePlainTextDrop(event, editor, synchronous);
}
