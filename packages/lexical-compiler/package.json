{
  "name": "@lexical/compiler",
  "description": "Build-time compiler for Lexical: tree-shaking annotations and inlining for the side-effect-free factories",
  "keywords": [
    "lexical",
    "editor",
    "compiler",
    "vite-plugin",
    "rollup-plugin",
    "tree-shaking"
  ],
  "version": "0.50.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facebook/lexical.git",
    "directory": "packages/lexical-compiler"
  },
  "bugs": {
    "url": "https://github.com/facebook/lexical/issues"
  },
  "homepage": "https://lexical.dev/docs/packages/lexical-compiler",
  "dependencies": {
    "@babel/parser": "^8.0.0",
    "magic-string": "^0.30.21"
  },
  "devDependencies": {
    "rollup": "^4.61.0"
  },
  "sideEffects": false,
  "exports": {
    "./PureAnnotations": {
      "source": "./src/PureAnnotations.ts",
      "types@<5.2": "./dist/typescript-too-old.d.ts",
      "types": "./dist/PureAnnotations.d.ts",
      "development": "./dist/LexicalCompilerPureAnnotations.dev.mjs",
      "production": "./dist/LexicalCompilerPureAnnotations.prod.mjs",
      "default": "./dist/LexicalCompilerPureAnnotations.mjs"
    },
    "./PureAnnotations.js": {
      "source": "./src/PureAnnotations.ts",
      "types@<5.2": "./dist/typescript-too-old.d.ts",
      "types": "./dist/PureAnnotations.d.ts",
      "development": "./dist/LexicalCompilerPureAnnotations.dev.mjs",
      "production": "./dist/LexicalCompilerPureAnnotations.prod.mjs",
      "default": "./dist/LexicalCompilerPureAnnotations.mjs"
    },
    ".": {
      "source": "./src/index.ts",
      "types@<5.2": "./dist/typescript-too-old.d.ts",
      "types": "./dist/index.d.ts",
      "development": "./dist/LexicalCompiler.dev.mjs",
      "production": "./dist/LexicalCompiler.prod.mjs",
      "default": "./dist/LexicalCompiler.mjs"
    }
  },
  "types": "./dist/typescript-too-old.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/typescript-too-old.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "typescript": ">=5.2"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "!src/__bench__",
    "!src/__mocks__",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.bench.ts",
    "!src/**/*.bench.tsx",
    "README.md",
    "LICENSE"
  ]
}
