/**
 * LexicalCompiler
 *
 * Every pass, re-exported. Import a single pass from its own entry point
 * (`@lexical/compiler/PureAnnotations`) to leave the rest unloaded.
 */

export type {
  PureAnnotationsOptions,
  PureAnnotationsPlugin,
  PureAnnotationsResult,
  PureAnnotationsSourceMap,
  TransformPureAnnotationsOptions,
} from './LexicalCompilerPureAnnotations';

export {
  INLINE_FACTORY_FORMS,
  PURE_FACTORY_FUNCTIONS,
  PURE_NAMESPACES,
  pureAnnotations,
  pureCallNames,
  transformPureAnnotations,
} from './LexicalCompilerPureAnnotations';

export type {
  CompileParseResult,
  SchemaJsonMeta,
  SchemaJsonSchema,
  SchemaJsonTable,
  VerifyCompiledParseOptions,
} from './LexicalCompilerSchemaJsonCodegen';

export {
  compileParse,
  JSON_NUMBER_SOURCE,
  literal,
  NotCompilable,
  NUM_HELPER_SOURCE,
  verificationCorpus,
  verifyCompiledParse,
  verifyTableCoversDomain,
} from './LexicalCompilerSchemaJsonCodegen';
