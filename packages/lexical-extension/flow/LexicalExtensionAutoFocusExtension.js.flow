import type {LexicalExtension} from 'lexical';
import type {NamedSignalsOutput} from '@lexical/extension/namedSignals';

export type DefaultSelection = 'rootStart' | 'rootEnd';

export type AutoFocusConfig = {
  defaultSelection: DefaultSelection,
  disabled: boolean,
};

declare export var AutoFocusExtension: LexicalExtension<
  AutoFocusConfig,
  '@lexical/extension/AutoFocus',
  NamedSignalsOutput<AutoFocusConfig>,
  void,
>;
