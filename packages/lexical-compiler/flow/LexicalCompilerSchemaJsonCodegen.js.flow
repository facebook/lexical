/**
 * LexicalCompilerSchemaJsonCodegen
 */

import type {
  AnySerializationSchema,
  SerializationSchemaMeta,
} from 'lexical';

export type SchemaJsonTable = {
  name: string,
  table: {readonly [key: string]: unknown},
};

export type CompileParseResult = {
  expression: string,
  tables: Array<SchemaJsonTable>,
};

export type VerifyCompiledParseOptions = {
  schema: AnySerializationSchema,
  expression: string,
  tables: ReadonlyArray<SchemaJsonTable>,
  nullPrototypeTables?: ReadonlyArray<string>,
};

declare export var JSON_NUMBER_SOURCE: string;
declare export var NUM_HELPER_SOURCE: string;
declare export var NUM_RANGE_HELPER_SOURCE: string;
declare export class NotCompilable extends Error {}

declare export function literal(value: unknown): string;

declare export function compileParse(
  meta: SerializationSchemaMeta,
  defaultValue: unknown,
  tableBaseName: string,
): CompileParseResult;

declare export function verificationCorpus(
  meta: SerializationSchemaMeta,
): Array<unknown>;

declare export function verifyCompiledParse(
  options: VerifyCompiledParseOptions,
): void;

declare export function verifyTableCoversDomain(options: {
  schema: AnySerializationSchema,
  table: {readonly [key: string]: unknown},
}): void;

declare export function compileDiffersFromDefault(
  schema: AnySerializationSchema,
  name: string,
): string;

declare export function verifyDiffersFromDefault(options: {
  expression: string,
  name: string,
  schema: AnySerializationSchema,
}): void;
