/**
 * Type-only smoke test for the hand-maintained Flow declarations.
 *
 * `pnpm lint-flow` checks that the `.flow` files export the same names as the
 * generated `.d.ts`, and `pnpm flow` checks that the declarations are
 * internally consistent. Neither one ever *calls* the declared API, so a
 * declaration can be exported, self-consistent, and still impossible to use
 * from a Flow codebase — which is how the extension types came to ship with
 * `defineExtension` uncallable.
 *
 * This file is that missing coverage: it consumes the public extension API
 * the way a downstream Flow app does. It is never imported at runtime, and
 * `flow/` is not in the package's published `files`.
 *
 * The `.js.flow` extension is load-bearing. Flow type-checks the contents of
 * `.js.flow` files, but `tsc` (which runs over the packages tree with
 * `allowJs`) does not recognise the extension, and both ESLint and Prettier
 * already ignore every `.js.flow` path. A plain `.js` file here fails
 * `pnpm tsc` on the Flow syntax (`error TS8006: 'import type' declarations
 * can only be used in TypeScript files`), because tsconfig's `exclude` only
 * covers `.js` files one directory below `packages`, which is one level
 * above this directory.
 */

import type {
  CompactSerializedEditorState,
  EditorState,
  LexicalEditor,
  LexicalExtensionConfig,
  LexicalExtensionOutput,
  SerializedEditorState,
  SerializedElementNode,
  SerializedLexicalNode,
  SerializedPartial,
  TextNode,
} from 'lexical';

import {defineExtension} from 'lexical';

type SmokeConfig = {greeting: string};

// An extension that declares no config, build, or init.
const minimalExtension = defineExtension({
  name: '@lexical/flow-smoke-test/Minimal',
});

// An extension carrying config and an output built at editor build time.
const configuredExtension = defineExtension({
  build(editor: LexicalEditor, config: SmokeConfig): {upper: string} {
    return {upper: config.greeting.toUpperCase()};
  },
  config: {greeting: 'hello'} as SmokeConfig,
  name: '@lexical/flow-smoke-test/Configured',
});

// The Config/Output helpers must still extract from a defined extension.
const extractedConfig: LexicalExtensionConfig<typeof configuredExtension> = {
  greeting: 'hi',
};
const extractedOutput: LexicalExtensionOutput<typeof configuredExtension> = {
  upper: 'HI',
};

export function flowSmokeTest(): string {
  return [
    minimalExtension.name,
    configuredExtension.name,
    extractedConfig.greeting,
    extractedOutput.upper,
  ].join(',');
}

/**
 * The compact serialized form omits every property equal to its schema
 * default, so a type that names those properties as present is wrong about the
 * value. TypeScript overloads `exportJSON`/`toJSON` on `compact` to say which
 * shape came back; these check that Flow does not hand a caller the legacy
 * shape for a compact call.
 */

// `EditorState` is extended by nothing, so the overload carries over intact.
export function flowCompactEditorState(
  state: EditorState,
): [SerializedEditorState, CompactSerializedEditorState] {
  const legacy: SerializedEditorState = state.toJSON();
  const compact: CompactSerializedEditorState = state.toJSON(true);
  // `compact.root.indent` is optional here — writing `.toFixed()` on it is the
  // error this overload exists to produce.
  return [legacy, compact];
}

// A compact export omits a default-valued property at every depth, so the
// relaxation has to reach the children too — `Partial<T>` alone made the array
// optional while still promising everything inside it was fully serialized.
export function flowCompactChildren(state: EditorState): number {
  const {children} = state.toJSON(true).root;
  if (children == null || children.length === 0) {
    return 0;
  }
  const child = children[0];
  // `version` is optional on a child, as it is on the root: writing
  // `child.version.toFixed(0)` is the error this recursion exists to produce.
  return child.version == null ? 0 : child.version;
}

// Nested elements, so the recursion is exercised past the first level. The
// children are `SerializedLexicalNode` at every depth — a node cannot declare
// what kind of children it takes — so what a compact child promises is only
// what every node has.
export function flowCompactNestedChildren(
  partial: SerializedPartial<SerializedElementNode>,
): number {
  const {children} = partial;
  if (children == null || children.length === 0) {
    return 0;
  }
  // A compact child carries only what a compact export wrote, so `version` is
  // optional here as it is on the root: `children[0].version.toFixed(0)` is the
  // error this recursion exists to produce.
  const child = children[0];
  return child.version == null ? 0 : child.version;
}

// A compact element is assignable from the little a compact export writes,
// nested children included.
export const flowCompactElement: SerializedPartial<SerializedElementNode> = {
  children: [{children: [{type: 'text'}], type: 'paragraph'}],
  type: 'root',
};

// `exportJSON` cannot be overloaded (see the declaration), so the compact
// argument is refused rather than answered with a shape the value does not
// have. A caller that wants it says what it really gets.
export function flowLegacyNodeExport(node: TextNode): [number, unknown] {
  const legacy: SerializedLexicalNode = node.exportJSON();
  const compact: SerializedPartial<SerializedLexicalNode> =
    // $FlowExpectedError[incompatible-type] the declaration takes no `true`
    node.exportJSON(true) as $FlowFixMe;
  return [legacy.version, compact.type];
}
