import type {LexicalExtension, ExtensionConfigBase, NodeKey} from 'lexical';
import type {ReadonlySignal} from '@lexical/extension/signals';

declare export var NodeSelectionExtension: LexicalExtension<
  ExtensionConfigBase,
  '@lexical/extension/NodeSelection',
  {
    watchNodeKey: (key: NodeKey) => ReadonlySignal<boolean>,
  },
  void,
>;
