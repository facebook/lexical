// Checked by `pnpm run flow` (not shipped): the public calls a Flow
// consumer makes type check.

import type {Doc} from '@y/y';

import {createEditor} from 'lexical';
import {describeStorage, YBinding} from '@lexical/y';

declare const doc: Doc;

const editor = createEditor();
const binding = new YBinding(editor, doc);
describeStorage(editor);
describeStorage(editor, binding);
describeStorage(editor, {pins: binding.pins});
// $FlowExpectedError[incompatible-type]
describeStorage(editor, {pins: 1});
