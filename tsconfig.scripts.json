{
  "compilerOptions": {
    // The generator imports the compiler's SchemaJsonCodegen.ts by path, with
    // its extension, which is how plain Node loads it before anything is built.
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": ["scripts", "packages/lexical-compiler/src/passes"],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "scripts/**/__tests__/unit/**",
    "scripts/__tests__/integration/fixtures/**"
  ],
  "extends": "./tsconfig.json"
}
