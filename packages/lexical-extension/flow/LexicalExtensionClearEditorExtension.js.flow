import type {LexicalExtension, LexicalEditor} from 'lexical';
import type {NamedSignalsOutput} from '@lexical/extension/namedSignals';

export type ClearEditorConfig = {
  $onClear: () => void,
};

declare export function registerClearEditor(
  editor: LexicalEditor,
  $onClear?: () => void,
): () => void;

declare export var ClearEditorExtension: LexicalExtension<
  ClearEditorConfig,
  '@lexical/extension/ClearEditor',
  NamedSignalsOutput<ClearEditorConfig>,
  void,
>;
