import type {LexicalExtension, LexicalEditor} from 'lexical';
import type {NamedSignalsOutput} from '@lexical/extension/namedSignals';

export type NestedEditorConfig = {
  $getParentEditor: () => LexicalEditor,
  inheritEditableFromParent: boolean,
};

declare export var NestedEditorExtension: LexicalExtension<
  NestedEditorConfig,
  '@lexical/extension/NestedEditor',
  NamedSignalsOutput<{
    inheritEditableFromParent: boolean,
  }>,
  void,
>;
